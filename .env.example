# All secrets stay in the backend process.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENALEX_API_KEY=

# Safe local defaults
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=data/ai_trends.db
REQUEST_TIMEOUT_SECONDS=25
MIN_SALARY_SAMPLE=10
PAPER_YEARS=5
OPENALEX_MAX_PER_DIRECTION=1000
OPENALEX_MAX_PER_YEAR=200
OPENALEX_PAGE_SIZE=100
CROSSREF_MAX_PER_DIRECTION=500
CROSSREF_MAX_PER_YEAR=100
CROSSREF_PAGE_SIZE=100
CROSSREF_MAILTO=
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.LG,cs.RO,cs.IR,eess.AS
MAX_JOBS_PER_SOURCE=1000
JOB_DROP_ALERT_RATIO=0.5
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_HOURS=24
SCHEDULER_CHECK_MINUTES=30
# Only used if the official ECB daily feed is temporarily unavailable.
USD_CNY_FALLBACK=6.713233
USD_CNY_FALLBACK_DATE=2026-09-25
